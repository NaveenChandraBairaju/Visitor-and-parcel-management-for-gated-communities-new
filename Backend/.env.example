# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration (Neon)
# Option 1: Use Neon Connection String (Recommended for Neon)
DATABASE_URL=postgresql://username:password@host.neon.tech/database_name?sslmode=require

# Option 2: Use Individual Connection Parameters (Fallback)
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=visitor_parcel_db

# Email Configuration (for OTP and notifications)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Notes:
# 1. For Neon deployment, use DATABASE_URL (get it from your Neon project dashboard)
# 2. The DATABASE_URL format: postgresql://user:password@host:port/database?sslmode=require
# 3. For Gmail SMTP, you need to enable 2FA and generate an app-specific password
# 4. Copy this file to .env and replace with your actual values
